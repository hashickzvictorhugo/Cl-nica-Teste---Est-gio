{
  "name": "garde-agenda",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:remote:migrate": "wrangler d1 execute clinica-teste-agendamentos-db --remote --file drizzle/0000_quick_leopardon.sql --yes",
    "db:remote:add-phone": "wrangler d1 execute clinica-teste-agendamentos-db --remote --file drizzle/0001_add_patient_phone.sql --yes",
    "db:remote:add-provider": "wrangler d1 execute clinica-teste-agendamentos-db --remote --file drizzle/0002_add_provider_schedule.sql --yes",
    "db:remote:add-status": "wrangler d1 execute clinica-teste-agendamentos-db --remote --file drizzle/0003_add_appointment_status.sql --yes",
    "db:remote:upgrade": "node scripts/migrate-production.mjs",
    "release:providers": "pnpm run build && pnpm run db:remote:add-provider && wrangler deploy",
    "release": "pnpm run build && pnpm run db:remote:upgrade && wrangler deploy",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:runtime": "pnpm audit --prod --audit-level=moderate",
    "audit:all": "pnpm audit --audit-level=high",
    "audit": "pnpm run audit:runtime && pnpm run audit:all",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "wrangler d1 execute DB --local --config dist/server/wrangler.json --persist-to .wrangler/state --file drizzle/bootstrap.sql"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  }
}
